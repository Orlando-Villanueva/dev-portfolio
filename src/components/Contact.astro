---
const content = {
    en: {
        eyebrow: "Free fit review",
        title: "Show me how quote requests arrive today.",
        subtitle:
            "Send your current setup and the details you need before calling a customer back. I’ll reply with whether a focused page, a form improvement, or a larger project is the useful next step.",
        name: "Name",
        email: "Email",
        currentSetup: "Current website, profile, listing, or no site",
        requestNeed: "What should a useful request tell you?",
        namePlaceholder: "Your name",
        emailPlaceholder: "you@example.com",
        currentSetupPlaceholder:
            "mysite.com, Google Business Profile, Facebook page, directory listing, or no site yet",
        requestNeedPlaceholder:
            "Your priority service and area, plus details such as job type, address, urgency, photos, access, or timing",
        submit: "Send my current setup",
        note:
            "This is a brief fit review, not a paid report or an obligation to start a project.",
        honeypot: "Don't fill this out if you're human:",
        subject: "New quote-request project inquiry",
    },
    fr: {
        eyebrow: "Courte évaluation sans frais",
        title: "Montrez-moi comment les demandes vous arrivent aujourd'hui.",
        subtitle:
            "Envoyez votre situation actuelle et les détails dont vous avez besoin avant de rappeler un client. Je vous dirai si une page ciblée, un meilleur formulaire ou un projet plus complet représente la prochaine étape utile.",
        name: "Nom",
        email: "Courriel",
        currentSetup: "Site, fiche, inscription actuelle ou absence de site",
        requestNeed: "Que devrait contenir une demande utile?",
        namePlaceholder: "Votre nom",
        emailPlaceholder: "vous@exemple.com",
        currentSetupPlaceholder:
            "monsite.com, fiche Google, page Facebook, annuaire ou aucun site pour le moment",
        requestNeedPlaceholder:
            "Votre service prioritaire et votre secteur, puis les détails utiles : type de travaux, adresse, urgence, photos, accès ou délai",
        submit: "Envoyer ma situation actuelle",
        note:
            "Il s'agit d'une courte évaluation de compatibilité, pas d'un rapport payant ni d'un engagement à démarrer un projet.",
        honeypot: "Ne remplissez pas ce champ si vous êtes humain:",
        subject: "Nouvelle demande pour améliorer la prise de soumissions",
    },
} as const;

interface Props {
    lang: keyof typeof content;
}

const { lang } = Astro.props;
const t = content[lang];
---

<section id="contact" class="bg-paper py-16 md:py-24">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-10 lg:grid-cols-[minmax(0,0.78fr)_minmax(28rem,1.22fr)] lg:gap-14">
            <div>
                <p class="section-label text-accent">{t.eyebrow}</p>
                <h2 class="mt-4 text-4xl leading-[0.98] md:text-5xl lg:text-6xl">
                    {t.title}
                </h2>
                <p class="mt-6 text-lg leading-relaxed text-steel">
                    {t.subtitle}
                </p>
                <p class="mt-6 text-sm font-medium leading-relaxed text-steel">
                    {t.note}
                </p>
            </div>

            <form
                name="contact"
                method="POST"
                action={`/${lang}/thank-you/`}
                data-netlify="true"
                data-netlify-honeypot="bot-field"
                class="border-t-2 border-navy bg-white p-5 md:p-8"
            >
                <input type="hidden" name="form-name" value="contact" />
                <input type="hidden" name="subject" value={t.subject} />
                <div class="hidden">
                    <label>{t.honeypot} <input name="bot-field" /></label>
                </div>

                <div class="grid gap-5 md:grid-cols-2">
                    <div class="form-field">
                        <label for="contact-name">{t.name}</label>
                        <input
                            type="text"
                            id="contact-name"
                            name="name"
                            autocomplete="name"
                            placeholder={t.namePlaceholder}
                            required
                        />
                    </div>
                    <div class="form-field">
                        <label for="contact-email">{t.email}</label>
                        <input
                            type="email"
                            id="contact-email"
                            name="email"
                            autocomplete="email"
                            placeholder={t.emailPlaceholder}
                            required
                        />
                    </div>
                </div>

                <div class="form-field mt-5">
                    <label for="contact-current-setup">
                        {t.currentSetup}
                    </label>
                    <input
                        type="text"
                        id="contact-current-setup"
                        name="current_setup"
                        placeholder={t.currentSetupPlaceholder}
                        required
                    />
                </div>

                <div class="form-field mt-5">
                    <label for="contact-request-need">{t.requestNeed}</label>
                    <textarea
                        id="contact-request-need"
                        name="request_need"
                        rows="6"
                        placeholder={t.requestNeedPlaceholder}
                        required
                    ></textarea>
                </div>

                <button type="submit" class="button-primary mt-6 w-full">
                    {t.submit}
                </button>
            </form>
        </div>
    </div>
</section>
