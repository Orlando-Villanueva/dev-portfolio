---
const content = {
  en: {
    title: "Request a quick website/lead audit",
    subtitle:
      "Send the site you have, the service you want more inquiries for, and where you serve clients. I’ll reply with the most useful next step.",
    name: "Name",
    email: "Email",
    service: "What do you need?",
    message: "Website URL, service area, and what you want to improve",
    submit: "Request audit",
    note: "Prefer a project discussion? Use the same form and include your timeline.",
    options: [
      "Website / AI Site Audit",
      "Bilingual Lead Page",
      "Lead Capture System",
      "Care Plan",
      "Other",
    ],
  },
  fr: {
    title: "Demander un audit rapide du site",
    subtitle:
      "Envoyez le site que vous avez, le service pour lequel vous voulez plus de demandes et votre secteur. Je vous répondrai avec la prochaine étape la plus utile.",
    name: "Nom",
    email: "Courriel",
    service: "De quoi avez-vous besoin?",
    message: "URL du site, secteur desservi et ce que vous voulez améliorer",
    submit: "Demander l'audit",
    note: "Vous préférez discuter d'un projet? Utilisez le même formulaire et ajoutez votre échéancier.",
    options: [
      "Audit de site / site IA",
      "Page de demandes bilingue",
      "Système de capture de demandes",
      "Plan d'entretien",
      "Autre",
    ],
  },
} as const;

interface Props {
  lang: keyof typeof content;
}

const { lang } = Astro.props;
const t = content[lang];
---

<section id="contact" class="py-20 bg-ghost">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-5xl font-bold text-navy mb-4">{t.title}</h2>
      <p class="text-slate text-lg">{t.subtitle}</p>
      <p class="text-slate text-sm mt-4">{t.note}</p>
    </div>

    <form
      name="contact"
      method="POST"
      action={`/${lang}/thank-you/`}
      data-netlify="true"
      data-netlify-honeypot="bot-field"
      class="bg-white p-8 md:p-12 rounded-[2rem] shadow-xl shadow-navy/5 space-y-6"
    >
      <input type="hidden" name="form-name" value="contact" />
      <input type="hidden" name="subject" value="Website audit request" />
      <div class="hidden">
        <label
          >Don't fill this out if you're human: <input
            name="bot-field"
          /></label
        >
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="space-y-2">
          <label class="text-sm font-bold text-navy ml-1">{t.name}</label>
          <input
            type="text"
            id="contact-name"
            name="name"
            required
            class="w-full px-6 py-4 rounded-xl border-2 border-slate/10 focus:border-accent outline-none transition-colors"
          />
        </div>
        <div class="space-y-2">
          <label class="text-sm font-bold text-navy ml-1">{t.email}</label>
          <input
            type="email"
            name="email"
            required
            class="w-full px-6 py-4 rounded-xl border-2 border-slate/10 focus:border-accent outline-none transition-colors"
          />
        </div>
      </div>

      <div class="space-y-2">
        <label class="text-sm font-bold text-navy ml-1">{t.service}</label>
        <select
          id="contact-service"
          name="service"
          class="w-full px-6 py-4 rounded-xl border-2 border-slate/10 focus:border-accent outline-none transition-colors appearance-none bg-white"
        >
          {t.options.map((opt) => <option>{opt}</option>)}
        </select>
      </div>

      <div class="space-y-2">
        <label class="text-sm font-bold text-navy ml-1">{t.message}</label>
        <textarea
          name="message"
          rows="4"
          required
          class="w-full px-6 py-4 rounded-xl border-2 border-slate/10 focus:border-accent outline-none transition-colors resize-none"
        ></textarea>
      </div>

      <button
        type="submit"
        class="w-full bg-accent text-white py-5 rounded-xl font-bold text-lg hover:bg-accent/90 transition-all shadow-lg shadow-accent/20"
      >
        {t.submit}
      </button>
    </form>
  </div>
</section>

<script>
  const form = document.querySelector(
    'form[name="contact"]',
  ) as HTMLFormElement;
  if (form) {
    const nameInput = form.querySelector(
      'input[name="name"]',
    ) as HTMLInputElement;
    const serviceSelect = form.querySelector(
      'select[name="service"]',
    ) as HTMLSelectElement;
    const subjectInput = form.querySelector(
      'input[name="subject"]',
    ) as HTMLInputElement;

    const updateSubject = () => {
      const name = nameInput?.value?.trim() || "New Client";
      const service = serviceSelect?.value || "General Inquiry";
      if (subjectInput) {
        subjectInput.value = `Website audit request from ${name} - ${service}`;
      }
    };

    nameInput?.addEventListener("input", updateSubject);
    serviceSelect?.addEventListener("change", updateSubject);

    // Final check on submit
    form.addEventListener("submit", updateSubject);

    // Initial run
    updateSubject();
  }
</script>
