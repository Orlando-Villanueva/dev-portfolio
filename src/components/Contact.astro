---
const content = {
  en: {
    title: "Request a Website Lead Review",
    subtitle:
      "Send the site you have, the service you want more inquiries for, and where you serve clients. I'll reply with the most useful next step.",
    name: "Name",
    email: "Email",
    service: "What do you need?",
    message: "Website URL, service area, and what you want to improve",
    namePlaceholder: "Your name",
    emailPlaceholder: "you@example.com",
    messagePlaceholder:
      "Example: mysite.com, serving Montreal and Valleyfield, fewer vague quote requests",
    submit: "Request review",
    note: "Send your URL, service area, and what feels messy. Prefer a project discussion? Include your timeline.",
    honeypot: "Don't fill this out if you're human:",
    subjectInitial: "Website Lead Review request",
    subjectPrefix: "Website Lead Review request from",
    defaultName: "New Client",
    defaultService: "General Inquiry",
    options: [
      "Website Lead Review",
      "Bilingual Lead Page",
      "Lead Capture System",
      "Care Plan",
      "Other",
    ],
  },
  fr: {
    title: "Demander une revue du site",
    subtitle:
      "Envoyez le site que vous avez, le service pour lequel vous voulez plus de demandes et votre secteur. Je vous répondrai avec la prochaine étape la plus utile.",
    name: "Nom",
    email: "Courriel",
    service: "De quoi avez-vous besoin?",
    message: "URL du site, secteur desservi et ce que vous voulez améliorer",
    namePlaceholder: "Votre nom",
    emailPlaceholder: "vous@exemple.com",
    messagePlaceholder:
      "Exemple : monsite.com, Montréal et Valleyfield, demandes de soumission trop vagues",
    submit: "Demander la revue",
    note: "Envoyez votre URL, votre secteur et ce qui semble confus. Pour discuter d'un projet, ajoutez aussi votre échéancier.",
    honeypot: "Ne remplissez pas ce champ si vous êtes humain:",
    subjectInitial: "Demande de revue du site",
    subjectPrefix: "Demande de revue du site de",
    defaultName: "Nouveau client",
    defaultService: "Demande générale",
    options: [
      "Analyse de génération de demandes",
      "Page de demandes bilingue",
      "Système de capture de demandes",
      "Plan d'entretien",
      "Autre",
    ],
  },
} as const;

interface Props {
  lang: keyof typeof content;
}

const { lang } = Astro.props;
const t = content[lang];
---

<section id="contact" class="py-16 md:py-20 bg-ghost">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-10 md:mb-12">
      <h2 class="text-3xl md:text-5xl font-bold text-navy mb-4">{t.title}</h2>
      <p class="text-slate text-lg">{t.subtitle}</p>
      <p class="text-slate text-sm mt-4 max-w-2xl mx-auto">{t.note}</p>
    </div>

    <form
      name="contact"
      method="POST"
      action={`/${lang}/thank-you/`}
      data-netlify="true"
      data-netlify-honeypot="bot-field"
      data-subject-prefix={t.subjectPrefix}
      data-default-name={t.defaultName}
      data-default-service={t.defaultService}
      class="bg-white p-6 md:p-10 rounded-[2rem] shadow-xl shadow-navy/5 space-y-6"
    >
      <input type="hidden" name="form-name" value="contact" />
      <input type="hidden" name="subject" value={t.subjectInitial} />
      <div class="hidden">
        <label>{t.honeypot} <input name="bot-field" /></label>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="space-y-2">
          <label for="contact-name" class="text-sm font-bold text-navy ml-1">{t.name}</label>
          <input
            type="text"
            id="contact-name"
            name="name"
            autocomplete="name"
            placeholder={t.namePlaceholder}
            required
            class="w-full px-6 py-4 rounded-xl border-2 border-slate/10 focus:border-accent outline-none transition-colors"
          />
        </div>
        <div class="space-y-2">
          <label for="contact-email" class="text-sm font-bold text-navy ml-1">{t.email}</label>
          <input
            type="email"
            id="contact-email"
            name="email"
            autocomplete="email"
            placeholder={t.emailPlaceholder}
            required
            class="w-full px-6 py-4 rounded-xl border-2 border-slate/10 focus:border-accent outline-none transition-colors"
          />
        </div>
      </div>

      <div class="space-y-2">
        <label for="contact-service" class="text-sm font-bold text-navy ml-1">{t.service}</label>
        <select
          id="contact-service"
          name="service"
          class="w-full px-6 py-4 rounded-xl border-2 border-slate/10 focus:border-accent outline-none transition-colors appearance-none bg-white"
        >
          {t.options.map((opt) => <option>{opt}</option>)}
        </select>
      </div>

      <div class="space-y-2">
        <label for="contact-message" class="text-sm font-bold text-navy ml-1">{t.message}</label>
        <textarea
          id="contact-message"
          name="message"
          rows="4"
          placeholder={t.messagePlaceholder}
          required
          class="w-full px-6 py-4 rounded-xl border-2 border-slate/10 focus:border-accent outline-none transition-colors resize-none"
        ></textarea>
      </div>

      <button
        type="submit"
        class="w-full bg-accent text-white py-5 rounded-xl font-bold text-lg hover:bg-accent/90 transition-all shadow-lg shadow-accent/20"
      >
        {t.submit}
      </button>
    </form>
  </div>
</section>

<script>
  const form = document.querySelector(
    'form[name="contact"]',
  ) as HTMLFormElement;
  if (form) {
    const nameInput = form.querySelector(
      'input[name="name"]',
    ) as HTMLInputElement;
    const serviceSelect = form.querySelector(
      'select[name="service"]',
    ) as HTMLSelectElement;
    const subjectInput = form.querySelector(
      'input[name="subject"]',
    ) as HTMLInputElement;

    const updateSubject = () => {
      const subjectPrefix =
        form.dataset.subjectPrefix || subjectInput?.value || "";
      const name =
        nameInput?.value?.trim() || form.dataset.defaultName || "";
      const service =
        serviceSelect?.value || form.dataset.defaultService || "";
      if (subjectInput) {
        subjectInput.value = subjectPrefix + " " + name + " - " + service;
      }
    };

    nameInput?.addEventListener("input", updateSubject);
    serviceSelect?.addEventListener("change", updateSubject);

    // Final check on submit
    form.addEventListener("submit", updateSubject);

    // Initial run
    updateSubject();
  }
</script>
