---
interface Props {
  headline: string;
  subheadline: string;
  primaryCTA: string;
  secondaryCTA: string;
  priceNote: string;
  availabilityText: string;
  localProof: string;
  mockup: {
    label: string;
    title: string;
    tagline: string;
    cta: string;
    services: readonly string[];
    area: string;
    hours: string;
    review: string;
    contact: string;
    note: string;
  };
}

const {
  headline,
  subheadline,
  primaryCTA,
  secondaryCTA,
  priceNote,
  availabilityText,
  localProof,
  mockup,
} = Astro.props;
---

<section class="relative overflow-hidden bg-paper pb-12 pt-14 md:pb-16 md:pt-20 lg:flex lg:min-h-[calc(100svh-5rem)] lg:items-center lg:py-12">
  <div class="absolute inset-x-0 bottom-0 h-px bg-steel/20"></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1.15fr)_minmax(16rem,0.85fr)] lg:gap-14">
      <div>
        <div
          class="mb-8 inline-flex items-center border border-steel/20 bg-white px-3 py-2 text-sm font-bold text-navy animate-fade-in lg:mb-5"
        >
          <span class="mr-2 flex h-2 w-2 bg-confirm"></span>
          {availabilityText}
        </div>

        <h1
          class="max-w-4xl text-5xl leading-[0.95] text-navy md:text-6xl lg:text-6xl"
        >
          {headline}
        </h1>

        <p
          class="mt-8 max-w-3xl text-lg leading-relaxed text-steel md:text-xl lg:mt-6"
        >
          {subheadline}
        </p>

        <p class="mt-5 text-sm font-bold text-navy/70 md:text-base lg:mt-4">
          {localProof}
        </p>

        <div class="mt-10 flex flex-col items-start gap-4 sm:flex-row sm:items-center lg:mt-7">
          <a
            href="#contact"
            data-umami-event="managed-website-cta"
            class="button-primary w-full sm:w-auto"
          >
            {primaryCTA}
          </a>
          <a
            href="#offer"
            class="button-secondary w-full sm:w-auto"
          >
            {secondaryCTA}
          </a>
        </div>

        <p class="mt-5 text-sm font-semibold text-steel lg:mt-4">{priceNote}</p>
      </div>

      <div class="md:pt-4">
        <p class="section-label text-accent">{mockup.label}</p>
        <div class="mt-4 overflow-hidden border border-steel/20 bg-white text-navy shadow-2xl">
          <div class="flex items-center justify-between border-b border-steel/15 px-5 py-4">
            <span class="font-bold">{mockup.title}</span>
            <span class="rounded bg-accent px-2 py-1 text-xs font-bold text-white">{mockup.contact}</span>
          </div>
          <div class="bg-paper px-6 py-8 md:px-8 md:py-10">
            <div class="grid gap-7 lg:grid-cols-[1.25fr_0.75fr] lg:items-end">
              <div>
                <p class="font-display text-4xl font-bold leading-none lg:text-5xl">{mockup.tagline}</p>
                <div class="mt-6 inline-flex bg-accent px-5 py-3 font-bold text-white">{mockup.cta}</div>
              </div>
              <div class="space-y-3 border-l-2 border-accent/40 pl-4 text-sm text-steel">
                <p>{mockup.area}</p>
                <p>{mockup.hours}</p>
                <p class="font-bold text-navy">{mockup.review}</p>
              </div>
            </div>
          </div>
          <div class="grid gap-px bg-steel/15 sm:grid-cols-3">
            {mockup.services.map((service) => (
              <div class="bg-white px-3 py-4 text-center text-xs font-bold">{service}</div>
            ))}
          </div>
        </div>
        <p class="mt-3 text-sm leading-relaxed text-steel">{mockup.note}</p>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .animate-fade-in {
    animation: fade-in 0.8s ease-out forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-fade-in {
      animation: none;
    }
  }
</style>
