---
interface Props {
  headline: string;
  subheadline: string;
  primaryCTA: string;
  secondaryCTA: string;
  priceNote: string;
  availabilityText: string;
  localProof: string;
}

const {
  headline,
  subheadline,
  primaryCTA,
  secondaryCTA,
  priceNote,
  availabilityText,
  localProof,
} = Astro.props;
---

<section class="relative overflow-hidden bg-paper pb-16 pt-28 md:pb-24 md:pt-40">
  <div class="absolute inset-x-0 bottom-0 h-px bg-steel/20"></div>
  <div class="absolute right-0 top-20 hidden h-px w-1/3 bg-accent/40 lg:block"></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div
      class="mb-8 inline-flex items-center border border-steel/20 bg-white px-3 py-2 text-sm font-bold text-navy animate-fade-in"
    >
      <span class="mr-2 flex h-2 w-2 bg-confirm"></span>
      {availabilityText}
    </div>

    <h1
      class="max-w-5xl text-5xl leading-[0.95] text-navy md:text-6xl lg:text-8xl"
    >
      {headline}
    </h1>

    <p
      class="mt-8 max-w-3xl text-lg leading-relaxed text-steel md:text-xl"
    >
      {subheadline}
    </p>

    <p class="mt-5 text-sm font-bold text-navy/70 md:text-base">
      {localProof}
    </p>

    <div class="mt-10 flex flex-col items-start gap-4 sm:flex-row sm:items-center">
      <a
        href="#contact"
        data-umami-event="hero-contact-cta"
        class="button-primary w-full sm:w-auto"
      >
        {primaryCTA}
      </a>
      <a
        href="#offer"
        data-umami-event="hero-inclusions-cta"
        class="button-secondary w-full sm:w-auto"
      >
        {secondaryCTA}
      </a>
    </div>

    <p class="mt-5 text-sm font-semibold text-steel">{priceNote}</p>
  </div>
</section>

<style>
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .animate-fade-in {
    animation: fade-in 0.8s ease-out forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-fade-in {
      animation: none;
    }
  }
</style>
