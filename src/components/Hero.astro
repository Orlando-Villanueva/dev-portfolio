---
interface Props {
  headline: string;
  subheadline: string;
  primaryCTA: string;
  secondaryCTA: string;
  availabilityText: string;
  localProof: string;
}

const {
  headline,
  subheadline,
  primaryCTA,
  secondaryCTA,
  availabilityText,
  localProof,
} = Astro.props;
---

<section class="relative pt-28 pb-16 md:pt-36 md:pb-20 overflow-hidden bg-ghost">
  <div class="absolute inset-x-0 bottom-0 h-px bg-slate/10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div
      class="inline-flex items-center px-4 py-2 rounded-full bg-navy/5 text-navy text-sm font-bold mb-8 animate-fade-in whitespace-nowrap"
    >
      <span class="flex h-2 w-2 rounded-full bg-emerald mr-2"></span>
      {availabilityText}
    </div>

    <h1
      class="text-4xl md:text-6xl font-bold text-navy leading-[1.08] mb-7 max-w-4xl mx-auto"
    >
      {headline}
    </h1>

    <p
      class="text-lg md:text-xl text-slate max-w-2xl mx-auto mb-5 leading-relaxed"
    >
      {subheadline}
    </p>

    <p class="text-sm md:text-base font-bold text-navy/75 mb-10">
      {localProof}
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="#contact"
        class="w-full sm:w-auto bg-navy text-white px-8 py-4 rounded-full font-bold text-lg hover:translate-y-[-2px] transition-all shadow-xl shadow-navy/20"
      >
        {primaryCTA}
      </a>
      <a
        href="#services"
        class="w-full sm:w-auto bg-white border-2 border-navy/10 text-navy px-8 py-4 rounded-full font-bold text-lg shadow-lg shadow-navy/5 hover:translate-y-[-2px] hover:border-navy/20 hover:shadow-xl hover:shadow-navy/10 transition-all"
      >
        {secondaryCTA}
      </a>
    </div>
  </div>
</section>

<style>
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .animate-fade-in {
    animation: fade-in 0.8s ease-out forwards;
  }
</style>
