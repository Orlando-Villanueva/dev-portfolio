---
import { getLocalizedHomePath } from "@/i18n/routes";

const content = {
  en: {
    links: [
      { name: "Offer", href: "#offer" },
      { name: "Pricing", href: "#pricing" },
      { name: "How it works", href: "#process" },
      { name: "Work", href: "#work" },
      { name: "FAQ", href: "#faq" },
    ],
    cta: "Get started",
    menuLabel: "Toggle menu",
  },
  fr: {
    links: [
      { name: "Offre", href: "#offer" },
      { name: "Tarifs", href: "#pricing" },
      { name: "Déroulement", href: "#process" },
      { name: "Réalisations", href: "#work" },
      { name: "Questions", href: "#faq" },
    ],
    cta: "Commencer",
    menuLabel: "Ouvrir ou fermer le menu",
  },
} as const;

interface Props {
  lang: keyof typeof content;
}

const { lang = "en" } = Astro.props;
const t = content[lang];
const currentLinks = t.links;
const homePath = getLocalizedHomePath(lang);
const sectionPath = (hash: string) => `${homePath}${hash}`;

// Logic for language switcher
const currentPath = Astro.url.pathname;
const otherLang = lang === "en" ? "fr" : "en";
let otherLangPath;
if (lang === "en") {
  if (currentPath === "/" || currentPath === "/en") {
    otherLangPath = "/fr";
  } else if (currentPath.startsWith("/en/")) {
    otherLangPath = "/fr" + currentPath.slice(3);
  } else {
    otherLangPath = "/fr" + (currentPath.startsWith("/") ? "" : "/") + currentPath;
  }
} else {
  if (currentPath === "/fr" || currentPath === "/fr/") {
    otherLangPath = "/";
  } else if (currentPath.startsWith("/fr/")) {
    otherLangPath = "/en" + currentPath.slice(3);
  } else {
    otherLangPath = "/";
  }
}
---

<nav
  x-data="{ isOpen: false }"
  class="fixed z-50 w-full border-b border-steel/20 bg-paper/90 backdrop-blur-md"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-20 items-center">
      <!-- Logo -->
      <div class="flex-shrink-0 flex items-center">
        <a
          href={homePath}
          class="text-2xl font-bold text-navy tracking-tight group"
        >
          Orlando<span class="text-accent">_</span>
        </a>
      </div>

      <!-- Desktop Menu -->
      <div class="hidden items-center space-x-6 lg:flex">
        {
          currentLinks.map((link) => (
            <a
              href={sectionPath(link.href)}
              class="font-medium text-steel transition-colors hover:text-navy"
            >
              {link.name}
            </a>
          ))
        }

        <div class="h-6 w-px bg-slate/20"></div>

        <!-- Lang Switcher -->
        <a
          href={otherLangPath}
          class="text-sm font-bold uppercase tracking-widest text-steel transition-colors hover:text-navy"
        >
          {otherLang}
        </a>

        <a
          href={sectionPath("#contact")}
          class="button-primary px-5 py-2.5 text-sm"
          data-umami-event="managed-website-cta"
        >
          {t.cta}
        </a>
      </div>

      <!-- Mobile menu button -->
      <div class="flex items-center space-x-4 lg:hidden">
        <a href={otherLangPath} class="text-sm font-bold uppercase text-steel"
          >{otherLang}</a
        >
        <button
          @click="isOpen = !isOpen"
          class="p-2 text-navy"
          aria-label={t.menuLabel}
        >
          <svg
            class="h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            x-show="!isOpen"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg
            class="h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            x-show="isOpen"
            style="display: none;"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div
    x-show="isOpen"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 -translate-y-4"
    x-transition:enter-end="opacity-100 translate-y-0"
    style="display: none;"
    class="border-b border-steel/20 bg-paper lg:hidden"
  >
    <div class="px-4 pt-2 pb-6 space-y-1">
      {
        currentLinks.map((link) => (
          <a
            href={sectionPath(link.href)}
            @click="isOpen = false"
            class="block border-b border-steel/15 px-3 py-4 text-lg font-bold text-navy"
          >
            {link.name}
          </a>
        ))
      }
      <div class="pt-6">
        <a
          href={sectionPath("#contact")}
          @click="isOpen = false"
          class="button-primary block w-full text-center"
          data-umami-event="managed-website-cta"
        >
          {t.cta}
        </a>
      </div>
    </div>
  </div>
</nav>
