---
const content = {
  en: {
    links: [
      { name: "Services", href: "#services" },
      { name: "Work", href: "#work" },
      { name: "About", href: "#about" },
      { name: "Contact", href: "#contact" },
    ],
    cta: "Request Audit",
  },
  fr: {
    links: [
      { name: "Services", href: "#services" },
      { name: "Réalisations", href: "#work" },
      { name: "À Propos", href: "#about" },
      { name: "Contact", href: "#contact" },
    ],
    cta: "Demander un audit",
  },
} as const;

interface Props {
  lang: keyof typeof content;
}

const { lang = "en" } = Astro.props;
const t = content[lang];
const currentLinks = t.links;

// Logic for language switcher
const currentPath = Astro.url.pathname;
const otherLang = lang === "en" ? "fr" : "en";
let otherLangPath;
if (lang === "en") {
  if (currentPath === "/" || currentPath === "/en") {
    otherLangPath = "/fr";
  } else if (currentPath.startsWith("/en/")) {
    otherLangPath = "/fr" + currentPath.slice(3);
  } else {
    otherLangPath = "/fr" + (currentPath.startsWith("/") ? "" : "/") + currentPath;
  }
} else {
  if (currentPath === "/fr" || currentPath === "/fr/") {
    otherLangPath = "/";
  } else if (currentPath.startsWith("/fr/")) {
    otherLangPath = "/en" + currentPath.slice(3);
  } else {
    otherLangPath = "/";
  }
}
---

<nav
  x-data="{ isOpen: false }"
  class="fixed w-full z-50 bg-ghost/80 backdrop-blur-md border-b border-slate/10"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-20 items-center">
      <!-- Logo -->
      <div class="flex-shrink-0 flex items-center">
        <a
          href={lang === "en" ? "/" : `/${lang}`}
          class="text-2xl font-bold text-navy tracking-tight group"
        >
          Orlando<span class="text-accent">_</span>
        </a>
      </div>

      <!-- Desktop Menu -->
      <div class="hidden md:flex items-center space-x-8">
        {
          currentLinks.map((link) => (
            <a
              href={link.href}
              class="text-slate hover:text-navy font-medium transition-colors"
            >
              {link.name}
            </a>
          ))
        }

        <div class="h-6 w-px bg-slate/20"></div>

        <!-- Lang Switcher -->
        <a
          href={otherLangPath}
          class="text-slate hover:text-navy font-bold uppercase text-sm tracking-widest"
        >
          {otherLang}
        </a>

        <a
          href="#contact"
          class="bg-navy text-white px-6 py-2.5 rounded-full font-bold hover:bg-navy/90 transition-all shadow-lg shadow-navy/10"
        >
          {t.cta}
        </a>
      </div>

      <!-- Mobile menu button -->
      <div class="md:hidden flex items-center space-x-4">
        <a href={otherLangPath} class="text-slate font-bold uppercase text-sm"
          >{otherLang}</a
        >
        <button
          @click="isOpen = !isOpen"
          class="text-navy p-2 focus:outline-none"
          aria-label="Toggle menu"
        >
          <svg
            class="h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            x-show="!isOpen"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg
            class="h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            x-show="isOpen"
            style="display: none;"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div
    x-show="isOpen"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 -translate-y-4"
    x-transition:enter-end="opacity-100 translate-y-0"
    style="display: none;"
    class="md:hidden bg-ghost border-b border-slate/10"
  >
    <div class="px-4 pt-2 pb-6 space-y-1">
      {
        currentLinks.map((link) => (
          <a
            href={link.href}
            @click="isOpen = false"
            class="block px-3 py-4 text-lg font-bold text-navy border-b border-slate/5"
          >
            {link.name}
          </a>
        ))
      }
      <div class="pt-6">
        <a
          href="#contact"
          @click="isOpen = false"
          class="block w-full text-center bg-navy text-white px-6 py-4 rounded-xl font-bold"
        >
          {t.cta}
        </a>
      </div>
    </div>
  </div>
</nav>
