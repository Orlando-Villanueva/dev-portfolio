---
const content = {
    en: {
        eyebrow: "Three simple steps",
        title: "From our first conversation to a live site in about two weeks.",
        timeline: "We keep the path clear: agree on the right plan, put the site online, then start the subscription.",
        steps: [
            { title: "We validate it together", body: "Choose Showcase or Booking, confirm your content and language, and agree on the details." },
            { title: "I put it online in about two weeks", body: "I prepare the page, connect the domain, make sure the buttons and form work, and launch after your quick review." },
            { title: "The subscription starts", body: "Your 12-month commitment begins at launch. Content updates and support are included." },
        ],
    },
    fr: {
        eyebrow: "Trois étapes simples",
        title: "De notre première discussion à un site en ligne en environ deux semaines.",
        timeline: "Le parcours reste clair : nous choisissons le bon forfait, je mets le site en ligne, puis l’abonnement commence.",
        steps: [
            { title: "Nous validons ensemble", body: "Choisissez Vitrine ou Réservation, confirmez votre contenu et votre langue, puis convenons des détails." },
            { title: "Je mets le site en ligne en environ deux semaines", body: "Je prépare la page, relie le domaine, m’assure que les boutons et le formulaire fonctionnent, puis lance le site après votre courte révision." },
            { title: "L’abonnement commence", body: "Votre engagement de 12 mois commence au lancement. Les mises à jour et le soutien sont inclus." },
        ],
    },
} as const;

interface Props { lang: keyof typeof content; }
const { lang = "en" } = Astro.props;
const t = content[lang];
---

<section id="process" class="bg-paper py-16 md:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-12 lg:grid-cols-[minmax(0,0.8fr)_minmax(28rem,1.2fr)] lg:gap-20">
            <div>
                <p class="section-label text-accent">{t.eyebrow}</p>
                <h2 class="mt-4 text-4xl leading-[0.98] md:text-5xl lg:text-6xl">{t.title}</h2>
                <p class="mt-6 leading-relaxed text-steel">{t.timeline}</p>
            </div>
            <ol class="border-t-2 border-navy">
                {t.steps.map((step, index) => (
                    <li class="grid grid-cols-[3rem_1fr] gap-4 border-b border-steel/25 py-6">
                        <span class="font-display text-3xl font-bold leading-none text-accent">{String(index + 1).padStart(2, "0")}</span>
                        <div><h3 class="text-xl leading-tight">{step.title}</h3><p class="mt-2 leading-relaxed text-steel">{step.body}</p></div>
                    </li>
                ))}
            </ol>
        </div>
    </div>
</section>
