---
const content = {
    en: {
        audienceEyebrow: "Who this is for",
        audienceTitle: "Quebec service businesses that depend on clear quote requests.",
        audienceIntro:
            "This fits local organizations where the website, Google profile, Facebook page, listing, or contact form needs to collect clearer job details before callback.",
        audiences: [
            "Cleaners and maintenance teams",
            "Contractors, trades, and home-service companies",
            "Local clinics, consultants, and client-request teams",
            "Churches, nonprofits, and community organizations",
        ],
        signals: [
            "You rely on quote requests, calls, bookings, forms, or client details.",
            "Clients often miss details your team needs before replying.",
            "You serve French and English visitors and want both sides to feel intentional.",
        ],
        processEyebrow: "How it works",
        processTitle: "A practical path from checkup to launch",
        steps: [
            {
                title: "Quote-path checkup",
                body: "Review the site, Google profile, Facebook page, listings, service area, mobile CTAs, forms, and bilingual gaps.",
            },
            {
                title: "Service and form plan",
                body: "Define the service focus, page structure, quote questions, notification details, and follow-up path.",
            },
            {
                title: "Implement and launch",
                body: "Repair the current path or create a focused bilingual page, then test mobile layout, forms, SEO basics, and deployment.",
            },
            {
                title: "Improve and maintain",
                body: "Monitor forms, update details, and make small improvements as services, seasons, or priorities change.",
            },
        ],
    },
    fr: {
        audienceEyebrow: "Pour qui",
        audienceTitle:
            "Entreprises de services au Québec qui dépendent de demandes claires.",
        audienceIntro:
            "Cette approche convient aux organisations locales dont le site, la fiche Google, la page Facebook, l'inscription ou le formulaire doit capter des détails de travail plus clairs avant le rappel.",
        audiences: [
            "Entreprises de nettoyage et équipes d'entretien",
            "Entrepreneurs, métiers spécialisés et services à domicile",
            "Cliniques locales, consultants et équipes d'accueil client",
            "Églises, OBNL et organismes communautaires",
        ],
        signals: [
            "Vous comptez sur les soumissions, appels, réservations, formulaires ou demandes client.",
            "Les clients oublient souvent des détails nécessaires avant votre réponse.",
            "Vous servez des visiteurs francophones et anglophones et voulez que les deux parcours soient soignés.",
        ],
        processEyebrow: "Comment ça fonctionne",
        processTitle: "Un parcours pratique du diagnostic au lancement",
        steps: [
            {
                title: "Diagnostic de prise de soumissions",
                body: "Revue du site, de la fiche Google, de la page Facebook, des inscriptions, du secteur desservi, des CTA mobiles, des formulaires et des écarts bilingues.",
            },
            {
                title: "Plan de service et de formulaire",
                body: "Définir le service ciblé, la structure de page, les questions de soumission, les détails d'avis courriel et le parcours de relance.",
            },
            {
                title: "Mise en oeuvre et lancement",
                body: "Réparer le parcours actuel ou créer une page bilingue ciblée, puis tester le mobile, les formulaires, les bases SEO et le déploiement.",
            },
            {
                title: "Amélioration et entretien",
                body: "Surveiller les formulaires, mettre les détails à jour et améliorer le système quand les services, saisons ou priorités changent.",
            },
        ],
    },
} as const;

interface Props {
    lang: keyof typeof content;
}

const { lang = "en" } = Astro.props;
const t = content[lang];
---

<section class="py-20 bg-ghost">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-[1.1fr_0.9fr] gap-12 lg:gap-16">
            <div>
                <p class="text-accent text-sm font-bold uppercase tracking-widest mb-4">
                    {t.audienceEyebrow}
                </p>
                <h2 class="text-3xl md:text-5xl font-bold text-navy mb-5 leading-tight">
                    {t.audienceTitle}
                </h2>
                <p class="text-slate text-lg leading-relaxed mb-8">
                    {t.audienceIntro}
                </p>

                <ul class="grid sm:grid-cols-2 gap-3 mb-8">
                    {
                        t.audiences.map((audience) => (
                            <li class="rounded-xl bg-white border border-slate/10 px-4 py-3 font-bold text-navy">
                                {audience}
                            </li>
                        ))
                    }
                </ul>

                <ul class="space-y-4">
                    {
                        t.signals.map((signal) => (
                            <li class="flex gap-3 text-slate leading-relaxed">
                                <span class="mt-1 h-5 w-5 shrink-0 rounded-full bg-emerald/10 text-emerald flex items-center justify-center text-xs font-bold">
                                    ✓
                                </span>
                                <span>{signal}</span>
                            </li>
                        ))
                    }
                </ul>
            </div>

            <div class="lg:pt-3">
                <p class="text-accent text-xs font-bold uppercase tracking-widest mb-3">
                    {t.processEyebrow}
                </p>
                <h3 class="text-2xl md:text-3xl font-bold text-navy mb-6 leading-tight">
                    {t.processTitle}
                </h3>

                <ol class="space-y-4">
                    {
                        t.steps.map((step, index) => (
                            <li class="grid grid-cols-[2.5rem_1fr] gap-4">
                                <div class="h-10 w-10 rounded-full bg-navy text-white flex items-center justify-center text-sm font-bold">
                                    {index + 1}
                                </div>
                                <div class="border-b border-slate/10 pb-4">
                                    <h4 class="text-lg font-bold text-navy mb-1">
                                        {step.title}
                                    </h4>
                                    <p class="text-slate leading-relaxed">
                                        {step.body}
                                    </p>
                                </div>
                            </li>
                        ))
                    }
                </ol>
            </div>
        </div>
    </div>
</section>
