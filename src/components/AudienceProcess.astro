---
const content = {
    en: {
        eyebrow: "A simple path to launch",
        title: "From your business details to a cared-for website.",
        timeline: "Most focused sites can launch about one to two weeks after all required content is received and the visual direction is approved. Client review time pauses the schedule, and I confirm timing after reviewing your materials.",
        steps: [
            { title: "Share the basics", body: "Send your current website or profile, the services you offer, and which payment option interests you." },
            { title: "Provide the essentials", body: "Share your business facts, logo, photos, contact details, hours, service area, and preferred language or languages." },
            { title: "Approve the visual direction", body: "I prepare one website-specific visual direction. You can request one focused adjustment. Full implementation starts only after your written approval." },
            { title: "Review the complete website", body: "I build from the approved direction and include one separate focused revision before launch." },
            { title: "Launch and hand off the worry", body: "I connect the domain, test the site and form, then handle hosting, monitoring, fixes, and routine updates." },
        ],
    },
    fr: {
        eyebrow: "Un parcours simple vers le lancement",
        title: "De vos renseignements d’entreprise à un site pris en charge.",
        timeline: "La plupart des sites ciblés peuvent être lancés environ une à deux semaines après la réception de tout le contenu requis et l’approbation de la direction visuelle. Le temps de révision du client met l’échéancier en pause, que je confirme après l’examen du matériel.",
        steps: [
            { title: "Partager l’essentiel", body: "Envoyez votre site ou fiche actuelle, les services offerts et l’option de paiement qui vous intéresse." },
            { title: "Fournir l’essentiel", body: "Partagez les renseignements, le logo, les photos, les coordonnées, les heures, le secteur et la ou les langues souhaitées." },
            { title: "Approuver la direction visuelle", body: "Je prépare une direction visuelle propre au site. Vous pouvez demander un ajustement ciblé. La création complète commence seulement après votre approbation écrite." },
            { title: "Réviser le site complet", body: "Je crée le site à partir de la direction approuvée et inclus une ronde de révision ciblée distincte avant le lancement." },
            { title: "Lancer et ne plus vous en soucier", body: "Je relie le domaine, teste le site et le formulaire, puis gère l’hébergement, la surveillance, les corrections et les mises à jour courantes." },
        ],
    },
} as const;

interface Props { lang: keyof typeof content; }
const { lang = "en" } = Astro.props;
const t = content[lang];
---

<section id="process" class="bg-paper py-16 md:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-12 lg:grid-cols-[minmax(0,0.8fr)_minmax(28rem,1.2fr)] lg:gap-20">
            <div>
                <p class="section-label text-accent">{t.eyebrow}</p>
                <h2 class="mt-4 text-4xl leading-[0.98] md:text-5xl lg:text-6xl">{t.title}</h2>
                <p class="mt-6 leading-relaxed text-steel">{t.timeline}</p>
            </div>
            <ol class="border-t-2 border-navy">
                {t.steps.map((step, index) => (
                    <li class="grid grid-cols-[3rem_1fr] gap-4 border-b border-steel/25 py-6">
                        <span class="font-display text-3xl font-bold leading-none text-accent">{String(index + 1).padStart(2, "0")}</span>
                        <div><h3 class="text-xl leading-tight">{step.title}</h3><p class="mt-2 leading-relaxed text-steel">{step.body}</p></div>
                    </li>
                ))}
            </ol>
        </div>
    </div>
</section>
