---
const content = {
    en: {
        eyebrow: "Have a site, profile, or listing?",
        title: "A page or profile can bring attention. Your business still needs a quote path that fits the job.",
        body: "Templates and listings can help people find you. I help finish the practical business layer Quebec service contractors need: sharper service positioning, bilingual copy, quote questions, form setup, local SEO structure, trust content, and follow-up details.",
        points: [
            "Make the service, service area, and next action obvious in seconds.",
            "Ask quote questions that match the job before the first callback.",
            "Connect profiles, pages, forms, CTAs, notifications, and follow-up so requests arrive with cleaner details.",
        ],
        cta: "Improve quote requests",
    },
    fr: {
        eyebrow: "Site, fiche ou inscription?",
        title: "Une page ou une fiche peut attirer l'attention. Votre entreprise a encore besoin d'un parcours de soumission adapté aux travaux.",
        body: "Les modèles et inscriptions peuvent aider les gens à vous trouver. J'aide à finir la couche d'affaires pratique dont les entrepreneurs de services au Québec ont besoin: positionnement plus clair, textes bilingues, questions de soumission, configuration du formulaire, structure SEO locale, contenu de confiance et détails de suivi.",
        points: [
            "Rendre le service, le secteur desservi et la prochaine action évidents en quelques secondes.",
            "Poser des questions de soumission adaptées au travail avant le premier rappel.",
            "Relier fiches, pages, formulaires, CTA, avis courriel et relances pour recevoir des demandes plus complètes.",
        ],
        cta: "Améliorer les soumissions",
    },
} as const;

interface Props {
    lang: keyof typeof content;
}

const { lang = "en" } = Astro.props;
const t = content[lang];
---

<section class="py-20 bg-navy text-white overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-[1.1fr_0.9fr] gap-12 items-center">
            <div>
                <p class="text-accent text-sm font-bold uppercase tracking-widest mb-5">
                    {t.eyebrow}
                </p>
                <h2 class="text-3xl md:text-5xl font-bold leading-tight text-white mb-6 max-w-4xl">
                    {t.title}
                </h2>
                <p class="text-slate-300 text-lg leading-relaxed max-w-3xl">
                    {t.body}
                </p>
            </div>

            <div class="border border-white/10 rounded-2xl p-7 bg-white/5">
                <ul class="space-y-5 mb-8">
                    {
                        t.points.map((point) => (
                            <li class="flex gap-3 text-white/85 leading-relaxed">
                                <span class="mt-1 h-5 w-5 rounded-full bg-emerald/20 text-emerald flex items-center justify-center text-sm font-bold">
                                    ✓
                                </span>
                                <span>{point}</span>
                            </li>
                        ))
                    }
                </ul>
                <a
                    href="#contact"
                    class="inline-flex w-full sm:w-auto justify-center bg-accent text-white px-7 py-4 rounded-xl font-bold hover:bg-accent/90 transition-colors"
                >
                    {t.cta}
                </a>
            </div>
        </div>
    </div>
</section>
