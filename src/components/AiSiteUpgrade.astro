---
const content = {
    en: {
        eyebrow: "Already have a site?",
        title: "AI, Wix, and Squarespace can start a page. Your business still needs the lead system around it.",
        body: "Templates can help you publish. I help finish the practical business layer Quebec service businesses need: sharper positioning, bilingual copy, quote forms, tracking, local SEO structure, trust content, and follow-up workflows.",
        points: [
            "Make the service, service area, and next action obvious in seconds.",
            "Ask better quote questions before the first reply.",
            "Connect forms, CTAs, tracking, and follow-up so inquiries arrive with cleaner details.",
        ],
        cta: "Request a website review",
    },
    fr: {
        eyebrow: "Vous avez déjà un site?",
        title: "L'IA, Wix et Squarespace peuvent lancer une page. Votre entreprise a encore besoin du système de demandes autour.",
        body: "Les modèles peuvent aider à publier. J'aide à finir la couche d'affaires pratique dont les entreprises de services au Québec ont besoin: positionnement plus clair, textes bilingues, formulaires de soumission, suivi, structure SEO locale, contenu de confiance et processus de relance.",
        points: [
            "Rendre le service, le secteur desservi et la prochaine action évidents en quelques secondes.",
            "Poser de meilleures questions de soumission avant le premier suivi.",
            "Relier formulaires, CTA, suivi et relances pour recevoir des demandes plus complètes.",
        ],
        cta: "Demander une revue du site",
    },
} as const;

interface Props {
    lang: keyof typeof content;
}

const { lang = "en" } = Astro.props;
const t = content[lang];
---

<section class="py-20 bg-navy text-white overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-[1.1fr_0.9fr] gap-12 items-center">
            <div>
                <p class="text-accent text-sm font-bold uppercase tracking-widest mb-5">
                    {t.eyebrow}
                </p>
                <h2 class="text-3xl md:text-5xl font-bold leading-tight text-white mb-6 max-w-4xl">
                    {t.title}
                </h2>
                <p class="text-slate-300 text-lg leading-relaxed max-w-3xl">
                    {t.body}
                </p>
            </div>

            <div class="border border-white/10 rounded-2xl p-7 bg-white/5">
                <ul class="space-y-5 mb-8">
                    {
                        t.points.map((point) => (
                            <li class="flex gap-3 text-white/85 leading-relaxed">
                                <span class="mt-1 h-5 w-5 rounded-full bg-emerald/20 text-emerald flex items-center justify-center text-sm font-bold">
                                    ✓
                                </span>
                                <span>{point}</span>
                            </li>
                        ))
                    }
                </ul>
                <a
                    href="#contact"
                    class="inline-flex w-full sm:w-auto justify-center bg-accent text-white px-7 py-4 rounded-xl font-bold hover:bg-accent/90 transition-colors"
                >
                    {t.cta}
                </a>
            </div>
        </div>
    </div>
</section>
