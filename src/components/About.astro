---
interface Props {
  heading: string;
  body: string;
  location: string;
  rigor: string;
  capability: string;
  professional: string;
}

const { heading, body, location, rigor, capability, professional } =
  Astro.props;
---

<section id="about" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div
      class="bg-navy rounded-[3rem] p-8 md:p-16 text-white overflow-hidden relative"
    >
      <!-- Decorative element -->
      <div
        class="absolute -bottom-20 -right-20 w-80 h-80 bg-accent/20 blur-[100px] rounded-full"
      >
      </div>

      <div class="flex flex-col md:flex-row gap-12 items-center relative z-10">
        <div class="w-full md:w-1/3">
          <div
            class="aspect-square bg-slate/20 rounded-3xl border border-white/10 flex items-center justify-center text-6xl"
          >
            👨‍💻
          </div>
        </div>

        <div class="w-full md:w-2/3 space-y-6">
          <div
            class="inline-block px-4 py-1.5 rounded-full bg-white/10 text-accent text-sm font-bold uppercase tracking-widest"
          >
            {location}
          </div>
          <h2 class="text-3xl md:text-5xl font-bold leading-tight text-white">
            {heading}
          </h2>
          <div class="space-y-4 text-slate-300 text-lg leading-relaxed">
            {body.split("\n\n").map((para) => <p>{para}</p>)}
          </div>

          <div
            class="pt-6 border-t border-white/10 flex flex-wrap gap-8 text-sm font-bold text-white/60"
          >
            <div class="flex items-center gap-2">
              <span class="text-accent">✔</span>
              {rigor}
            </div>
            <div class="flex items-center gap-2">
              <span class="text-accent">✔</span>
              {capability}
            </div>
            <div class="flex items-center gap-2">
              <span class="text-accent">✔</span>
              {professional}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
