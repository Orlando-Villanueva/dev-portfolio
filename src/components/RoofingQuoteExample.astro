---
const content = {
    en: {
        eyebrow: "Illustrative roofing example",
        heading: "The form asks about the job. The notification arrives ready for a useful callback.",
        intro:
            "This is an example flow, not a real client submission. The exact questions change with the contractor and the work they quote.",
        customerLabel: "What the customer answers",
        notificationLabel: "What the contractor receives",
        formTitle: "Roofing request",
        fields: [
            { label: "Work needed", value: "Repair" },
            { label: "Problem", value: "Active leak" },
            { label: "Property", value: "Detached home" },
            { label: "Location", value: "Vaudreuil-Dorion" },
            { label: "Timing", value: "As soon as possible" },
            { label: "Photos", value: "3 attached" },
            { label: "Callback", value: "After 4:30 p.m.", wide: true },
        ],
        notificationTitle: "New roof repair request",
        status: "Ready to review",
        notificationSummary:
            "Active leak at a detached home in Vaudreuil-Dorion. Three photos attached. Customer prefers a call after 4:30 p.m.",
        details: [
            ["Job", "Roof repair"],
            ["Urgency", "Active leak"],
            ["Area", "Vaudreuil-Dorion"],
            ["Photos", "3 files"],
        ],
        footer:
            "Fewer basics to chase down before deciding when and how to follow up.",
    },
    fr: {
        eyebrow: "Exemple fictif en toiture",
        heading:
            "Le formulaire pose des questions sur les travaux. L'avis arrive prêt pour un rappel utile.",
        intro:
            "Il s'agit d'un exemple, pas d'une vraie demande client. Les questions sont adaptées à l'entrepreneur et aux travaux qu'il soumissionne.",
        customerLabel: "Ce que le client fournit",
        notificationLabel: "Ce que l'entrepreneur reçoit",
        formTitle: "Demande en toiture",
        fields: [
            { label: "Travaux", value: "Réparation" },
            { label: "Problème", value: "Fuite active" },
            { label: "Propriété", value: "Maison individuelle" },
            { label: "Secteur", value: "Vaudreuil-Dorion" },
            { label: "Délai", value: "Dès que possible" },
            { label: "Photos", value: "3 jointes" },
            { label: "Rappel", value: "Après 16 h 30", wide: true },
        ],
        notificationTitle: "Nouvelle demande de réparation",
        status: "Prête à évaluer",
        notificationSummary:
            "Fuite active sur une maison individuelle à Vaudreuil-Dorion. Trois photos jointes. Le client préfère un appel après 16 h 30.",
        details: [
            ["Travaux", "Réparation de toiture"],
            ["Urgence", "Fuite active"],
            ["Secteur", "Vaudreuil-Dorion"],
            ["Photos", "3 fichiers"],
        ],
        footer:
            "Moins de renseignements de base à rechercher avant de décider quand et comment faire le suivi.",
    },
} as const;

interface Props {
    lang: keyof typeof content;
}

const { lang = "en" } = Astro.props;
const t = content[lang];
---

<section id="roofing-example" class="bg-navy py-16 text-white md:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl">
            <p class="section-label text-blue-300">{t.eyebrow}</p>
            <h2 class="mt-4 max-w-3xl text-4xl leading-[0.98] text-white md:text-5xl lg:text-6xl">
                {t.heading}
            </h2>
            <p class="mt-6 max-w-3xl text-lg leading-relaxed text-white/70">
                {t.intro}
            </p>
        </div>

        <div class="job-flow mt-12 grid gap-5 lg:grid-cols-[minmax(0,0.92fr)_4rem_minmax(0,1.08fr)] lg:items-center">
            <article class="job-sheet bg-white text-navy">
                <div class="job-sheet__header">
                    <p class="section-label text-slate">{t.customerLabel}</p>
                    <h3 class="mt-2 text-xl leading-tight md:text-2xl">
                        {t.formTitle}
                    </h3>
                </div>
                <dl class="grid grid-cols-2">
                    {
                        t.fields.map((field) => (
                            <div
                                class:list={[
                                    "job-field",
                                    "wide" in field && field.wide
                                        ? "col-span-2"
                                        : "",
                                ]}
                            >
                                <dt>{field.label}</dt>
                                <dd>{field.value}</dd>
                            </div>
                        ))
                    }
                </dl>
            </article>

            <div class="flow-arrow" aria-hidden="true">
                <span></span>
                <svg viewBox="0 0 24 24">
                    <path
                        d="M5 12h14M13 6l6 6-6 6"
                        fill="none"
                        stroke="currentColor"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="1.75"></path>
                </svg>
            </div>

            <article class="job-sheet job-sheet--notification bg-paper text-navy">
                <div class="job-sheet__header border-b border-steel/20">
                    <div class="flex flex-wrap items-start justify-between gap-4">
                        <div>
                            <p class="section-label text-slate">
                                {t.notificationLabel}
                            </p>
                            <h3 class="mt-2 text-xl leading-tight md:text-2xl">
                                {t.notificationTitle}
                            </h3>
                        </div>
                        <span class="status-stamp">{t.status}</span>
                    </div>
                </div>

                <dl class="grid grid-cols-2 border-b border-steel/20">
                    {
                        t.details.map(([label, value]) => (
                            <div class="job-field">
                                <dt>{label}</dt>
                                <dd>{value}</dd>
                            </div>
                        ))
                    }
                </dl>

                <div class="p-5 md:p-6">
                    <p class="text-base leading-relaxed text-steel">
                        {t.notificationSummary}
                    </p>
                    <p class="mt-5 border-l-2 border-confirm pl-4 text-sm font-semibold leading-relaxed text-navy">
                        {t.footer}
                    </p>
                </div>
            </article>
        </div>
    </div>
</section>
