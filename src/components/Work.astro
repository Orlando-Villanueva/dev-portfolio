---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

const labels = {
    en: {
        eyebrow: "A real small-business website",
        title:
            "Hierronix needed a professional home for its services and requests.",
        subtitle:
            "The project shows the same practical foundation: a fast bilingual site, clear service information, and a contact path that works around the clock.",
        problem: "Business problem",
        solution: "What I built",
        result: "Practical outcome",
    },
    fr: {
        eyebrow: "Un vrai site de petite entreprise",
        title:
            "Hierronix avait besoin d’un espace professionnel pour ses services et ses demandes.",
        subtitle:
            "Le projet présente la même base pratique : un site bilingue rapide, des services clairs et un parcours de contact accessible en tout temps.",
        problem: "Problème d'affaires",
        solution: "Ce que j'ai créé",
        result: "Résultat pratique",
    },
} as const;

interface Props {
    lang: keyof typeof labels;
}

const { lang } = Astro.props;
const projects = await getCollection("projects", ({ id }) =>
    id.startsWith(`${lang}/`),
);
projects.sort((a, b) => {
    const priority = (id: string) => (id.includes("hierronix") ? 0 : 1);
    return priority(a.id) - priority(b.id);
});

const primaryProject = projects[0];
const t = labels[lang];

const tagStyles: Record<string, string> = {
    Laravel: "bg-red-50 text-red-700 border-red-100",
    Astro: "bg-purple-50 text-purple-700 border-purple-100",
    "Tailwind CSS": "bg-sky-50 text-sky-700 border-sky-100",
    htmx: "bg-indigo-50 text-indigo-700 border-indigo-100",
    "Alpine.js": "bg-cyan-50 text-cyan-700 border-cyan-100",
    PostgreSQL: "bg-blue-50 text-blue-800 border-blue-100",
};

const getTagStyle = (tag: string) =>
    tagStyles[tag] || "bg-navy/5 text-navy border-steel/15";
---

<section id="work" class="bg-white py-16 md:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl">
            <p class="section-label text-accent">{t.eyebrow}</p>
            <h2 class="mt-4 text-4xl leading-[0.98] md:text-5xl lg:text-6xl">
                {t.title}
            </h2>
            <p class="mt-6 max-w-3xl text-lg leading-relaxed text-steel">
                {t.subtitle}
            </p>
        </div>

        {
            primaryProject && (
                <article class="mt-12 grid gap-8 border-t-2 border-navy pt-8 lg:grid-cols-[minmax(0,1.02fr)_minmax(24rem,0.98fr)] lg:gap-14">
                    <div class="self-start overflow-hidden bg-paper">
                        <Image
                            src={primaryProject.data.image}
                            alt={primaryProject.data.title}
                            width={1600}
                            format="webp"
                            quality="high"
                            class="block aspect-[16/10] w-full object-cover object-top"
                        />
                    </div>

                    <div>
                        <div class="flex flex-wrap gap-2">
                            {primaryProject.data.tags.map((tag) => (
                                <span
                                    class={`border px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider ${getTagStyle(tag)}`}
                                >
                                    {tag}
                                </span>
                            ))}
                        </div>

                        <h3 class="mt-5 text-3xl leading-tight">
                            {primaryProject.data.title}
                        </h3>
                        <p class="mt-3 text-xl font-semibold text-accent">
                            {primaryProject.data.tagline}
                        </p>

                        <dl class="mt-7">
                            <div class="border-t border-steel/25 py-4">
                                <dt class="section-label text-steel">{t.problem}</dt>
                                <dd class="mt-2 leading-relaxed text-navy">
                                    {primaryProject.data.problem}
                                </dd>
                            </div>
                            <div class="border-t border-steel/25 py-4">
                                <dt class="section-label text-steel">{t.solution}</dt>
                                <dd class="mt-2 leading-relaxed text-navy">
                                    {primaryProject.data.solution}
                                </dd>
                            </div>
                            <div class="border-y border-steel/25 py-4">
                                <dt class="section-label text-confirm">{t.result}</dt>
                                <dd class="mt-2 font-semibold leading-relaxed text-navy">
                                    {primaryProject.data.result}
                                </dd>
                            </div>
                        </dl>
                    </div>
                </article>
            )
        }

    </div>
</section>
