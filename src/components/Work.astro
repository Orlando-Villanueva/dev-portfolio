---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
const labels = {
  en: {
    title: "Proof behind the offers",
    subtitle:
      "Hierronix Care shows the practical quote-request work. Delight App shows the deeper full-stack engineering behind that quality.",
    problem: "Business Problem",
    solution: "What I Built",
    result: "Practical Outcome",
  },
  fr: {
    title: "La preuve derrière les offres",
    subtitle:
      "Hierronix Care montre le travail pratique de prise de soumissions. Delight App montre la profondeur d'ingénierie full-stack derrière cette qualité.",
    problem: "Problème d'affaires",
    solution: "Ce que j'ai bâti",
    result: "Résultat pratique",
  },
} as const;

interface Props {
  lang: keyof typeof labels;
}

const { lang } = Astro.props;
const projects = await getCollection("projects", ({ id }) => {
  return id.startsWith(`${lang}/`);
});
projects.sort((a, b) => {
  const priority = (id: string) => (id.includes("hierronix") ? 0 : 1);
  return priority(a.id) - priority(b.id);
});

const t = labels[lang];

const tagStyles: Record<string, string> = {
  Laravel: "bg-red-50 text-red-700 border border-red-100",
  Astro: "bg-purple-50 text-purple-700 border border-purple-100",
  "Tailwind CSS": "bg-sky-50 text-sky-700 border border-sky-100",
  htmx: "bg-indigo-50 text-indigo-700 border border-indigo-100",
  "Alpine.js": "bg-cyan-50 text-cyan-700 border border-cyan-100",
  PostgreSQL: "bg-blue-50 text-blue-800 border border-blue-100",
  TypeScript: "bg-blue-50 text-blue-700 border border-blue-100",
  MySQL: "bg-orange-50 text-orange-700 border border-orange-100",
};

const getTagStyle = (tag: string) => {
  return tagStyles[tag] || "bg-navy/5 text-navy border border-transparent";
};
---

<section id="work" class="py-20 bg-ghost">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div
      class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6"
    >
      <div class="max-w-2xl">
        <h2 class="text-3xl md:text-5xl font-bold text-navy mb-4">{t.title}</h2>
        <p class="text-slate text-lg">{t.subtitle}</p>
      </div>
    </div>

    <div class="space-y-24">
      {
        projects.map((project, index) => (
          <div
            class={`flex flex-col ${index % 2 === 0 ? "lg:flex-row" : "lg:flex-row-reverse"} gap-12 items-center`}
          >
            <div class="w-full lg:w-1/2">
              <div class="relative group rounded-3xl overflow-hidden shadow-2xl">
                <Image
                  src={project.data.image}
                  alt={project.data.title}
                  width={1600}
                  format="webp"
                  quality="high"
                  class="block w-full aspect-[16/10] object-cover object-top group-hover:scale-105 transition-transform duration-500"
                />
              </div>
            </div>

            <div class="w-full lg:w-1/2 space-y-6">
              <div class="flex flex-wrap gap-2">
                {project.data.tags.map((tag) => (
                  <span
                    class={`px-3 py-1 rounded-full text-[10px] font-bold tracking-wider uppercase transition-all ${getTagStyle(tag)}`}
                  >
                    {tag}
                  </span>
                ))}
              </div>

              <h3 class="text-3xl font-bold text-navy">{project.data.title}</h3>
              <p class="text-xl text-accent font-medium italic">
                {project.data.tagline}
              </p>

              <div class="grid gap-6 pt-4">
                <div class="border-l-4 border-slate/10 pl-6">
                  <p class="text-xs font-bold text-slate uppercase tracking-widest mb-1">
                    {t.problem}
                  </p>
                  <p class="text-navy">{project.data.problem}</p>
                </div>
                <div class="border-l-4 border-slate/10 pl-6">
                  <p class="text-xs font-bold text-slate uppercase tracking-widest mb-1">
                    {t.solution}
                  </p>
                  <p class="text-navy">{project.data.solution}</p>
                </div>
                <div class="border-l-4 border-emerald/30 pl-6">
                  <p class="text-xs font-bold text-emerald uppercase tracking-widest mb-1">
                    {t.result}
                  </p>
                  <p class="text-navy font-medium">{project.data.result}</p>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
