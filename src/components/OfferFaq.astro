---
const content = {
    en: {
        eyebrow: "Questions before you start",
        title: "Simple answers about the plans and the commitment.",
        items: [
            { q: "Who owns the domain and website?", a: "Your domain always belongs to you. The website is part of the managed service while your subscription is active. If you leave before 12 months, you can pay a $500 transfer fee and the site becomes yours, or have it deactivated." },
            { q: "Why a subscription instead of a one-time payment?", a: "The site is only the beginning. Your monthly plan covers the domain, hosting, content updates, and someone who can help when something needs changing. You do not have to find a new person for every small fix." },
            { q: "What happens after 12 months?", a: "The 12-month commitment ends and the subscription continues month to month with no new commitment. You can stop with 30 days’ notice." },
            { q: "I already have a Facebook page. Why do I need a website?", a: "A website gives customers one clear place for your services, prices, service area, and contact options. You control it, and customers can find it without relying on a social-media feed." },
            { q: "AI makes free websites. Why pay you?", a: "The site is the easy part. The domain, hosting, updates, and someone who answers when it breaks are what keep it useful. That is the part I take care of." },
            { q: "Do you need a bilingual site?", a: "Let’s talk — custom quote." },
            { q: "What updates are included?", a: "Content updates are included for your text, services, prices, hours, photos, and contact details. New pages or new features are available as one-time options or a separate quote." },
            { q: "What else can I add?", a: "One-time options include an extra page for $150 per page or a simple logo for $150. The Booking plan also adds a booking or quote form with automatic confirmation and a Google reviews page." },
        ],
    },
    fr: {
        eyebrow: "Questions avant de commencer",
        title: "Des réponses simples sur les forfaits et l’engagement.",
        items: [
            { q: "À qui appartiennent le domaine et le site?", a: "Votre nom de domaine vous appartient toujours. Le site fait partie du service géré pendant votre abonnement. Si vous partez avant 12 mois, vous pouvez payer 500 $ pour transférer le site, qui devient alors votre propriété, ou le faire désactiver." },
            { q: "Pourquoi un abonnement plutôt qu’un paiement unique?", a: "Le site n’est que le début. Votre forfait mensuel couvre le domaine, l’hébergement, les mises à jour et une personne qui peut vous aider quand quelque chose doit changer. Vous n’avez pas à trouver quelqu’un pour chaque petite correction." },
            { q: "Que se passe-t-il après 12 mois?", a: "L’engagement de 12 mois se termine et l’abonnement continue au mois, sans nouvel engagement. Vous pouvez arrêter avec un préavis de 30 jours." },
            { q: "J’ai déjà une page Facebook. Pourquoi un site?", a: "Un site donne aux clients un endroit clair pour vos services, vos tarifs, votre secteur et vos moyens de contact. Vous le contrôlez et vos clients peuvent le trouver sans dépendre d’un fil de réseau social." },
            { q: "L’IA fait des sites gratuits. Pourquoi vous payer?", a: "Le site est la partie facile. Le domaine, l’hébergement, les mises à jour et quelqu’un qui répond quand ça brise sont ce qui le garde utile. C’est cette partie que je prends en charge." },
            { q: "Besoin d’un site bilingue?", a: "Parlons-en — devis sur mesure." },
            { q: "Quelles mises à jour sont incluses?", a: "Les mises à jour de contenu sont incluses pour vos textes, services, tarifs, heures, photos et coordonnées. Les nouvelles pages ou fonctions sont offertes en option ou sur devis distinct." },
            { q: "Qu’est-ce que je peux ajouter?", a: "Les options en paiement unique comprennent une page supplémentaire à 150 $ par page ou un logo simple à 150 $. Le forfait Réservation ajoute aussi un formulaire de réservation ou de soumission avec confirmation automatique et une page d’avis Google." },
        ],
    },
} as const;

interface Props { lang: keyof typeof content; }
const { lang = "en" } = Astro.props;
const t = content[lang];
---

<section id="faq" class="bg-paper py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl">
            <p class="section-label text-accent">{t.eyebrow}</p>
            <h2 class="mt-4 text-4xl leading-[0.98] md:text-5xl lg:text-6xl">{t.title}</h2>
        </div>
        <div class="mt-10 border-t-2 border-navy">
            {t.items.map((item, index) => (
                <details open={index === 0} class="group border-b border-steel/25 py-5">
                    <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-lg font-bold text-navy">
                        <span>{item.q}</span><span class="text-2xl font-normal text-accent transition-transform group-open:rotate-45" aria-hidden="true">+</span>
                    </summary>
                    <p class="max-w-4xl pb-2 pt-4 leading-relaxed text-steel">{item.a}</p>
                </details>
            ))}
        </div>
    </div>
</section>
