---
const content = {
    en: {
        eyebrow: "Clear boundaries before we start",
        title: "Ownership, care, and what this service does not include.",
        items: [
            { q: "Who owns the website, and what happens if I cancel care?", a: "You own your domain, business content, and website from launch. Care may be cancelled at the end of any paid monthly period. Once outstanding amounts are paid, I provide the agreed website files for transfer, and my hosting, monitoring, updates, and technical responsibility end." },
            { q: "What changes and revisions are included?", a: "The service includes one focused adjustment to the visual direction, one separate pre-launch website revision, and up to 30 minutes per month for routine text, photo, hours, service, or contact-detail changes. Monthly time does not roll over. New pages, redesigns, and functionality are quoted separately." },
            { q: "Can the website be bilingual, and do you create branding?", a: "The site can be English, French, or both according to your customers, with no bilingual surcharge. I use your existing logo, photos, colours, and identity to establish the website’s look. Logo creation, naming, photography, and broader brand strategy are not included." },
            { q: "What is outside the service or paid separately?", a: "Ecommerce, online payments, booking systems, accounts, custom applications, integrations, advertising, ongoing SEO or content campaigns, email administration, emergency support, unlimited revisions, and complicated legacy-site rescue are outside the standard service. Domain registration and optional third-party services are paid separately. I will explain whether a larger need can be quoted or should go to a specialist." },
        ],
    },
    fr: {
        eyebrow: "Des limites claires avant de commencer",
        title: "Propriété, entretien et éléments non compris dans le service.",
        items: [
            { q: "À qui appartient le site et que se passe-t-il si j’annule l’entretien?", a: "Votre domaine, le contenu de votre entreprise et le site vous appartiennent dès le lancement. L’entretien peut être annulé à la fin de toute période mensuelle payée. Une fois les sommes dues réglées, je fournis les fichiers convenus pour le transfert, puis mon hébergement, ma surveillance, mes mises à jour et ma responsabilité technique prennent fin." },
            { q: "Quels changements et quelles révisions sont inclus?", a: "Le service comprend un ajustement ciblé de la direction visuelle, une révision distincte du site avant le lancement et jusqu’à 30 minutes par mois pour les changements courants de texte, photos, heures, services ou coordonnées. Le temps mensuel n’est pas reporté. Les nouvelles pages, refontes et fonctionnalités font l’objet d’un devis distinct." },
            { q: "Le site peut-il être bilingue et créez-vous une image de marque?", a: "Le site peut être en français, en anglais ou dans les deux langues selon votre clientèle, sans supplément bilingue. J’utilise votre logo, vos photos, vos couleurs et votre identité existante pour définir l’apparence du site. La création d’un logo, le choix d’un nom, la photographie et une stratégie de marque plus large ne sont pas inclus." },
            { q: "Qu’est-ce qui est exclu ou payé séparément?", a: "Le commerce électronique, les paiements, la réservation, les comptes, les applications sur mesure, les intégrations, la publicité, les campagnes SEO ou de contenu, la gestion des courriels, le soutien d’urgence, les révisions illimitées et le sauvetage de sites complexes sont exclus du service standard. Le domaine et les services externes facultatifs sont payés séparément. Je vous dirai si un besoin plus important peut faire l’objet d’un devis ou devrait être confié à un spécialiste." },
        ],
    },
} as const;

interface Props { lang: keyof typeof content; }
const { lang = "en" } = Astro.props;
const t = content[lang];
---

<section id="faq" class="bg-paper py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl">
            <p class="section-label text-accent">{t.eyebrow}</p>
            <h2 class="mt-4 text-4xl leading-[0.98] md:text-5xl lg:text-6xl">{t.title}</h2>
        </div>
        <div class="mt-10 border-t-2 border-navy">
            {t.items.map((item) => (
                <details class="group border-b border-steel/25 py-5">
                    <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-lg font-bold text-navy">
                        <span>{item.q}</span><span class="text-2xl font-normal text-accent transition-transform group-open:rotate-45" aria-hidden="true">+</span>
                    </summary>
                    <p class="max-w-4xl pb-2 pt-4 leading-relaxed text-steel">{item.a}</p>
                </details>
            ))}
        </div>
    </div>
</section>
