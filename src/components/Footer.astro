---
import { getLocalizedHomePath } from "@/i18n/routes";

const labels = {
  en: {
    tagline: "Professional websites built and cared for with simple monthly pricing.",
    explore: "Explore",
    connect: "Connect",
    rights: "All rights reserved.",
    built: "Based near Montreal. Serving Canada.",
    links: {
      offer: "Managed website",
      pricing: "Pricing",
      work: "Client work",
    },
  },
  fr: {
    tagline: "Sites Web professionnels créés et entretenus avec une tarification mensuelle simple.",
    explore: "Explorer",
    connect: "Me suivre",
    rights: "Tous droits réservés.",
    built: "Établi près de Montréal. Au service du Canada.",
    links: {
      offer: "Site Web géré",
      pricing: "Tarifs",
      work: "Réalisations",
    },
  },
} as const;

interface Props {
  lang: keyof typeof labels;
}

const { lang = "en" } = Astro.props;
const t = labels[lang];
const homePath = getLocalizedHomePath(lang);
const sectionPath = (hash: string) => `${homePath}${hash}`;
---

<footer class="border-t border-white/10 bg-navy pb-10 pt-16 text-white/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid md:grid-cols-4 gap-12 mb-16">
      <div class="col-span-2">
        <a href={homePath} class="mb-6 block text-2xl font-bold text-white">
          Orlando<span class="text-accent">_</span>
        </a>
        <p class="max-w-xs leading-relaxed">
          {t.tagline}
        </p>
      </div>

      <div>
        <h4 class="mb-6 font-bold text-white">{t.explore}</h4>
        <ul class="space-y-4">
          <li>
            <a
              href={sectionPath("#offer")}
              class="transition-colors hover:text-blue-300"
              >{t.links.offer}</a
            >
          </li>
          <li>
            <a
              href={sectionPath("#pricing")}
              class="transition-colors hover:text-blue-300"
              >{t.links.pricing}</a
            >
          </li>
          <li>
            <a
              href={sectionPath("#work")}
              class="transition-colors hover:text-blue-300"
              >{t.links.work}</a
            >
          </li>
        </ul>
      </div>

      <div>
        <h4 class="text-white font-bold mb-6">{t.connect}</h4>
        <ul class="space-y-4">
          <li>
            <a
              href="https://github.com/orlando-villanueva"
              class="transition-colors hover:text-blue-300">GitHub</a
            >
          </li>
          <li>
            <a
              href={sectionPath("#contact")}
              class="transition-colors hover:text-blue-300"
              >Contact</a
            >
          </li>
        </ul>
      </div>
    </div>

    <div
      class="pt-8 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-4 text-sm"
    >
      <p>© {new Date().getFullYear()} Orlando_ {t.rights}</p>
      <p>{t.built}</p>
    </div>
  </div>
</footer>
