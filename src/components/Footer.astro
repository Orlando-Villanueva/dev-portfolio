---
const labels = {
  en: {
    tagline: "Bilingual lead systems for Quebec service businesses.",
    solutions: "Solutions",
    connect: "Connect",
    rights: "All rights reserved.",
    built: "Built with Astro in Montreal.",
    services: {
      marketing: "Website Reviews",
      automation: "Lead Pages",
      webApps: "Lead Capture",
    },
  },
  fr: {
    tagline: "Systèmes de demandes bilingues pour entreprises de services au Québec.",
    solutions: "Solutions",
    connect: "Me suivre",
    rights: "Tous droits réservés.",
    built: "Construit avec Astro à Montréal.",
    services: {
      marketing: "Revues de site",
      automation: "Pages de demandes",
      webApps: "Capture de demandes",
    },
  },
} as const;

interface Props {
  lang: keyof typeof labels;
}

const { lang = "en" } = Astro.props;
const t = labels[lang];
---

<footer class="bg-navy pt-20 pb-10 text-white/80 border-t border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid md:grid-cols-4 gap-12 mb-16">
      <div class="col-span-2">
        <a href={`/${lang}`} class="text-2xl font-bold text-white mb-6 block">
          Orlando<span class="text-accent">_</span>
        </a>
        <p class="max-w-xs leading-relaxed">
          {t.tagline}
        </p>
      </div>

      <div>
        <h4 class="text-white font-bold mb-6">{t.solutions}</h4>
        <ul class="space-y-4">
          <li>
            <a href="#services" class="hover:text-accent transition-colors"
              >{t.services.marketing}</a
            >
          </li>
          <li>
            <a href="#services" class="hover:text-accent transition-colors"
              >{t.services.automation}</a
            >
          </li>
          <li>
            <a href="#services" class="hover:text-accent transition-colors"
              >{t.services.webApps}</a
            >
          </li>
        </ul>
      </div>

      <div>
        <h4 class="text-white font-bold mb-6">{t.connect}</h4>
        <ul class="space-y-4">
          <li>
            <a
              href="https://github.com/orlando-villanueva"
              class="hover:text-accent transition-colors">GitHub</a
            >
          </li>
          <li>
            <a href="#contact" class="hover:text-accent transition-colors"
              >Contact</a
            >
          </li>
        </ul>
      </div>
    </div>

    <div
      class="pt-8 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-4 text-sm"
    >
      <p>© {new Date().getFullYear()} Orlando_ {t.rights}</p>
      <p>{t.built}</p>
    </div>
  </div>
</footer>
