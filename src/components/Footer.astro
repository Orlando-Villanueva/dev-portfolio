---
const { lang = 'en' } = Astro.props;

const labels = {
  en: { 
    tagline: 'Technical Reliability. Business Growth.',
    solutions: 'Solutions',
    connect: 'Connect',
    rights: 'All rights reserved.'
  },
  fr: { 
    tagline: 'Fiabilité technique. Croissance commerciale.',
    solutions: 'Solutions',
    connect: 'Connexion',
    rights: 'Tous droits réservés.'
  }
};

const t = labels[lang];
---

<footer class="bg-navy pt-20 pb-10 text-white/80 border-t border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid md:grid-cols-4 gap-12 mb-16">
      <div class="col-span-2">
        <a href={`/${lang}`} class="text-2xl font-bold text-white mb-6 block">
          Orlando<span class="text-accent underline decoration-4 underline-offset-4">.</span>
        </a>
        <p class="max-w-xs leading-relaxed">
          {t.tagline}
        </p>
      </div>

      <div>
        <h4 class="text-white font-bold mb-6">{t.solutions}</h4>
        <ul class="space-y-4">
          <li><a href="#services" class="hover:text-accent transition-colors">Marketing Sites</a></li>
          <li><a href="#services" class="hover:text-accent transition-colors">Automation</a></li>
          <li><a href="#services" class="hover:text-accent transition-colors">Web Apps</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-white font-bold mb-6">{t.connect}</h4>
        <ul class="space-y-4">
          <li><a href="https://linkedin.com" class="hover:text-accent transition-colors">LinkedIn</a></li>
          <li><a href="https://github.com" class="hover:text-accent transition-colors">GitHub</a></li>
          <li><a href="#contact" class="hover:text-accent transition-colors">Contact</a></li>
        </ul>
      </div>
    </div>

    <div class="pt-8 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-4 text-sm">
      <p>© {new Date().getFullYear()} Orlando. {t.rights}</p>
      <p>Made with ⚡ and Astro in Montreal.</p>
    </div>
  </div>
</footer>
