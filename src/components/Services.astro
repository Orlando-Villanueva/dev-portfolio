---
const content = {
    en: {
        eyebrow: "One focused offer",
        heading:
            "A bilingual quote page that asks the right questions before you call back.",
        intro:
            "I build a clear path from the place customers find you to a focused form that matches the work you quote.",
        price: "Projects start at $750 CAD",
        priceNote:
            "The starting scope covers one priority service and one focused English/French page and form.",
        includesLabel: "What the focused setup includes",
        includes: [
            "Job-specific questions and natural English/French copy",
            "A clear path from Google, Facebook, directories, or your current site",
            "Email notification, confirmation, and follow-up wording",
            "Mobile testing and deployment",
        ],
        startingLabel: "Built around what you have now",
        startingPoints: [
            {
                title: "Profile or listing only",
                body: "Create a focused destination beyond a Google profile, Facebook page, or directory listing.",
            },
            {
                title: "Weak or broken website",
                body: "Replace the unclear request path without turning every project into a full rebuild.",
            },
            {
                title: "Usable site, generic form",
                body: "Add better questions and calls to action while keeping the parts that already work.",
            },
        ],
        scope:
            "Larger bilingual sites, multi-service flows, booking logic, and custom integrations are quoted separately.",
        cta: "Improve my quote requests",
    },
    fr: {
        eyebrow: "Une offre ciblée",
        heading:
            "Une page bilingue qui pose les bonnes questions avant votre rappel.",
        intro:
            "Je crée un parcours clair entre l'endroit où les clients vous trouvent et un formulaire adapté aux travaux que vous soumissionnez.",
        price: "Projets à partir de 750 $ CA",
        priceNote:
            "Le mandat de départ couvre un service prioritaire ainsi qu'une page et un formulaire ciblés en français et en anglais.",
        includesLabel: "Ce que comprend la mise en place ciblée",
        includes: [
            "Questions adaptées aux travaux et textes naturels en français et en anglais",
            "Parcours clair depuis Google, Facebook, les annuaires ou votre site actuel",
            "Avis courriel, confirmation et textes de suivi",
            "Tests mobiles et déploiement",
        ],
        startingLabel: "Adaptée à votre situation actuelle",
        startingPoints: [
            {
                title: "Fiche ou inscription seulement",
                body: "Créer une destination ciblée au-delà d'une fiche Google, d'une page Facebook ou d'un annuaire.",
            },
            {
                title: "Site faible ou brisé",
                body: "Remplacer le parcours de demande confus sans transformer chaque mandat en refonte complète.",
            },
            {
                title: "Site utilisable, formulaire générique",
                body: "Ajouter de meilleures questions et de meilleurs appels à l'action tout en gardant ce qui fonctionne.",
            },
        ],
        scope:
            "Les sites bilingues plus complets, les parcours multiservices, la réservation et les intégrations sur mesure font l'objet d'une soumission distincte.",
        cta: "Améliorer mes demandes",
    },
} as const;

interface Props {
    lang: keyof typeof content;
}

const { lang = "en" } = Astro.props;
const t = content[lang];
---

<section id="offer" class="bg-white py-16 md:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-10 lg:grid-cols-[minmax(0,0.92fr)_minmax(24rem,1.08fr)] lg:gap-16">
            <div>
                <p class="section-label text-accent">{t.eyebrow}</p>
                <h2 class="mt-4 max-w-3xl text-4xl leading-[0.98] md:text-5xl lg:text-6xl">
                    {t.heading}
                </h2>
                <p class="mt-6 max-w-2xl text-lg leading-relaxed text-steel">
                    {t.intro}
                </p>

                <div class="mt-8 border-y border-steel/25 py-5">
                    <p class="text-2xl font-bold text-navy">{t.price}</p>
                    <p class="mt-2 max-w-xl text-sm leading-relaxed text-steel">
                        {t.priceNote}
                    </p>
                </div>

                <a
                    href="#contact"
                    class="button-primary mt-8 inline-flex"
                >
                    {t.cta}
                </a>
            </div>

            <div class="border-t-2 border-navy bg-paper">
                <div class="border-b border-steel/20 p-5 md:p-7">
                    <p class="section-label text-steel">{t.includesLabel}</p>
                </div>
                <ul>
                    {
                        t.includes.map((item) => (
                            <li class="flex gap-4 border-b border-steel/20 px-5 py-4 text-navy md:px-7">
                                <span
                                    class="mt-0.5 shrink-0 text-base font-bold leading-none text-confirm"
                                    aria-hidden="true"
                                >
                                    ✓
                                </span>
                                <span class="font-semibold leading-relaxed">
                                    {item}
                                </span>
                            </li>
                        ))
                    }
                </ul>
                <p class="p-5 text-sm leading-relaxed text-steel md:p-7">
                    {t.scope}
                </p>
            </div>
        </div>

        <div class="mt-14 border-t border-steel/25 pt-8 md:mt-20">
            <p class="section-label text-steel">{t.startingLabel}</p>
            <div class="mt-5 grid gap-px overflow-hidden border border-steel/20 bg-steel/20 md:grid-cols-3">
                {
                    t.startingPoints.map((point) => (
                        <article class="bg-white p-5 md:p-6">
                            <h3 class="text-xl leading-tight">{point.title}</h3>
                            <p class="mt-3 text-sm leading-relaxed text-steel">
                                {point.body}
                            </p>
                        </article>
                    ))
                }
            </div>
        </div>
    </div>
</section>
