    en: [
        {
            title: "Website Lead Review",
            price: "$250-$500 typical project range",
            outcome: "Clarity before you spend more.",
            summary:
                "A diagnostic review of your existing website, AI-built page, or basic online presence to see what’s helping — or blocking — quote requests.",
            includes: [
                "Website, Google Business Profile, mobile CTAs, forms, analytics, and local SEO review",
                "Bilingual copy and trust-content notes",
                "Keep, improve, or rebuild recommendation plus prioritized action plan",
            ],
            bestFor:
                "You already have a website and want a clear plan before deciding whether to improve it or rebuild it.",
            scopeNote:
                "Review and recommendations only. Implementation is quoted separately.",
            icon: "M9 12h6m-6 4h6m2 5H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2Z",
            featured: false,
            compact: true,
        },
        {
            title: "Bilingual Lead Page",
            price: "$900-$1,800 starting range",
            outcome: "A focused bilingual page built to capture quote requests.",
            summary:
                "The main offer for one service, one local market, and one clear quote or booking action in English and French.",
            includes: [
                "Mobile-first bilingual page structure",
                "Local positioning, trust sections, form or CTA, deployment, and SEO basics",
                "Clear quote or booking path for one service area",
                "Quality assurance across both languages before launch",
            ],
            bestFor:
                "You need a focused page for a specific service area without building a full site.",
            scopeNote: null,
            icon: "M4 5h16M4 12h10M4 19h16m0-14v14",
            featured: true,
            compact: false,
        },
        {
            title: "Lead Capture System",
            price: "$2,500-$5,000 typical range",
            outcome: "Cleaner intake for businesses with more moving parts.",
            summary:
                "The advanced upgrade for businesses that need cleaner quote intake before the team replies.",
            includes: [
                "Quote intake, routing, tracking, and follow-up flow",
                "Bilingual service pages, trust content, local SEO structure, and conversion-focused CTAs",
                "Cleaner details from calls, forms, texts, DMs, and booking requests",
            ],
            bestFor:
                "You waste time chasing missing details and want a website that supports the whole inquiry process.",
            scopeNote: null,
            icon: "M8 7h8m-8 4h8m-8 4h5m8-12 4 4-4 4M5 5a2 2 0 0 1 2-2h7.5L19 7.5V19a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V5Z",
            featured: false,
            compact: false,
        },
        {
            title: "Care Plan",
            price: "$150-$400/mo starting range",
            outcome: "Ongoing care for the system after launch.",
            summary:
                "Ongoing support after launch for businesses that rely on forms, bookings, and fresh service details.",
            includes: [
                "Updates, small improvements, and performance checks",
                "Form monitoring and lead-system maintenance",
                "Practical adjustments as services, seasons, or service areas change",
            ],
            bestFor:
                "Your website is part of daily operations and should not sit untouched after launch.",
            scopeNote: null,
            icon: "M9 12l2 2 4-4m5 2a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z",
            featured: false,
            compact: false,
        },
    ],
    fr: [
        {
            title: "Analyse de génération de demandes",
            price: "Fourchette typique de projet : 250 $ à 500 $",
            outcome: "De la clarté avant d'investir davantage.",
            summary:
                "Une analyse de votre site actuel, page créée avec l’IA ou présence en ligne de base pour voir ce qui aide — ou bloque — les demandes de soumission.",
            includes: [
                "Analyse du site, de la fiche Google Business Profile, des appels à l’action mobiles, des formulaires, des statistiques et du SEO local",
                "Notes sur le contenu bilingue et les éléments de confiance",
                "Recommandation claire et plan d'action priorisé : conserver, améliorer ou reconstruire",
            ],
            bestFor:
                "Vous avez déjà un site et voulez un plan clair avant de décider s'il vaut mieux l'améliorer ou le reconstruire.",
            scopeNote:
                "Analyse et recommandations seulement. La mise en œuvre est soumissionnée séparément.",
            icon: "M9 12h6m-6 4h6m2 5H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2Z",
            featured: false,
            compact: true,
        },
        {
            title: "Page de demandes bilingue",
            price: "900 $ à 1 800 $ pour démarrer",
            outcome: "Une page bilingue ciblée pour capter les demandes de soumission.",
            summary:
                "L'offre principale pour un service, un marché local et une action claire de soumission ou de réservation, en français et en anglais.",
            includes: [
                "Structure bilingue pensée d'abord pour mobile",
                "Positionnement local, sections de confiance, formulaire ou CTA, déploiement et bases SEO",
                "Parcours clair de soumission ou de réservation pour un secteur de service",
                "Assurance qualité dans les deux langues avant la mise en ligne",
            ],
            bestFor:
                "Vous avez besoin d'une page ciblée pour un service précis sans créer un site complet.",
            scopeNote: null,
            icon: "M4 5h16M4 12h10M4 19h16m0-14v14",
            featured: true,
            compact: false,
        },
        {
            title: "Système de capture de demandes",
            price: "2 500 $ à 5 000 $ typiquement",
            outcome: "Une prise de demandes plus claire quand il y a plus de détails à gérer.",
            summary:
                "L'option avancée pour les entreprises qui veulent des demandes plus claires avant la réponse de leur équipe.",
            includes: [
                "Formulaire de soumission, routage, suivi et processus de relance",
                "Pages de services bilingues, contenu de confiance, structure SEO locale et CTA orientés conversion",
                "Détails plus propres provenant des appels, formulaires, textos, messages et réservations",
            ],
            bestFor:
                "Vous perdez du temps à chercher les détails manquants et voulez un site qui soutient tout le processus de demande.",
            scopeNote: null,
            icon: "M8 7h8m-8 4h8m-8 4h5m8-12 4 4-4 4M5 5a2 2 0 0 1 2-2h7.5L19 7.5V19a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V5Z",
            featured: false,
            compact: false,
        },
        {
            title: "Plan d'entretien",
            price: "150 $ à 400 $/mois pour démarrer",
            outcome: "Un entretien continu du système après le lancement.",
            summary:
                "Un soutien continu après le lancement pour les entreprises qui comptent sur les formulaires, réservations et détails de services à jour.",
            includes: [
                "Mises à jour, petites améliorations et vérifications de performance",
                "Surveillance des formulaires et entretien du système de demandes",
                "Ajustements pratiques lorsque les services, saisons ou secteurs changent",
            ],
            bestFor:
                "Votre site fait partie des opérations quotidiennes et ne devrait pas rester immobile après le lancement.",
            scopeNote: null,
            icon: "M9 12l2 2 4-4m5 2a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z",
            featured: false,
            compact: false,
        },
    ],
} as const;

const labels = {
    en: {
        eyebrow: "What you can buy",
        heading: "Offers built around better local inquiries",
        intro:
            "Start with a diagnostic review, build the flagship bilingual lead page, or expand into a fuller intake system when the business needs it.",
        includes: "Includes",
        bestFor: "Best for",
        outcome: "Outcome",
        featured: "Main offer",
        cta: "Request a website review",
        addOnEyebrow: "Post-review implementation path",
        addOnTitle: "Existing Site Improvement Sprint",
        addOnBody:
            "If your current site is worth keeping, focused improvements can be quoted separately from $500-$1,500+, depending on platform access, technical condition, and scope. If the site is hard to modify cleanly, I will recommend rebuilding as a Bilingual Lead Page instead.",
    },
    fr: {
        eyebrow: "Ce que vous pouvez acheter",
        heading: "Des offres construites pour de meilleures demandes locales",
        intro:
            "Commencez par une revue diagnostique, bâtissez la Page de demandes bilingue principale ou ajoutez un système de capture plus complet quand l'entreprise en a besoin.",
        includes: "Inclus",
        bestFor: "Idéal pour",
        outcome: "Résultat",
        featured: "Offre principale",
        cta: "Demander une revue du site",
        addOnEyebrow: "Option après la revue",
        addOnTitle: "Sprint d'amélioration du site existant",
        addOnBody:
            "Si votre site actuel vaut la peine d'être gardé, des améliorations ciblées peuvent être proposées séparément de 500 $ à 1 500 $ et plus, selon l'accès à la plateforme, l'état technique et la portée. Si le site est difficile à modifier proprement, je recommanderai plutôt une Page de demandes bilingue.",
    },
} as const;

interface Props {
    lang: keyof typeof services;
}

const { lang = "en" } = Astro.props;
const currentServices = services[lang];
const primaryServices = currentServices.slice(0, 2);
const supportingServices = currentServices.slice(2);
const t = labels[lang];
---

<section id="services" class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mb-14">
            <p class="text-accent text-sm font-bold uppercase tracking-widest mb-4">
                {t.eyebrow}
            </p>
            <h2 class="text-3xl md:text-5xl font-bold text-navy mb-5">
                {t.heading}
            </h2>
            <p class="text-slate text-lg leading-relaxed">
                {t.intro}
            </p>
        </div>

        <div class="grid lg:grid-cols-[0.82fr_1.18fr] gap-6">
            {
                primaryServices.map((service) => (
                    <article
                        class:list={[
                            "relative rounded-2xl border transition-all",
                            service.compact ? "p-6 md:p-7" : "p-7 md:p-9",
                            service.featured
                                ? "border-accent/50 bg-ghost shadow-xl shadow-accent/10"
                                : "border-slate/10 bg-white hover:border-accent/25",
                        ]}
                    >
                        {service.featured && (
                            <p class="absolute right-6 top-6 text-xs font-bold uppercase tracking-widest text-accent">
                                {t.featured}
                            </p>
                        )}
                        <div class="pr-28">
                            <div class="w-12 h-12 bg-accent/10 rounded-xl flex items-center justify-center mb-6 text-accent">
                                <svg
                                    class="w-6 h-6"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                    aria-hidden="true"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d={service.icon}
                                    />
                                </svg>
                            </div>
                            <h3 class="text-2xl font-bold text-navy mb-2">
                                {service.title}
                            </h3>
                        </div>
                        <p class="text-xs font-bold text-navy uppercase tracking-widest mb-2">
                            {t.outcome}
                        </p>
                        <p
                            class:list={[
                                "font-bold text-navy leading-snug mb-4",
                                service.featured ? "text-xl md:text-2xl" : "text-lg",
                            ]}
                        >
                            {service.outcome}
                        </p>
                        <p class="text-base font-bold text-accent mb-4">
                            {service.price}
                        </p>
                        <p class="text-slate leading-relaxed mb-5">
                            {service.summary}
                        </p>
                        <div class="border-t border-slate/10 pt-5 mb-6">
                            <p class="text-xs font-bold text-navy uppercase tracking-widest mb-2">
                                {t.bestFor}
                            </p>
                            <p class="text-navy leading-relaxed">
                                {service.bestFor}
                            </p>
                        </div>
                        <div class="grid gap-5">
                            <div>
                                <p class="text-xs font-bold text-navy uppercase tracking-widest mb-3">
                                    {t.includes}
                                </p>
                                <ul class="space-y-3">
                                    {service.includes.map((item) => (
                                        <li class="flex gap-3 text-slate leading-relaxed">
                                            <span class="mt-1 h-5 w-5 shrink-0 rounded-full bg-emerald/10 text-emerald flex items-center justify-center text-xs font-bold">
                                                ✓
                                            </span>
                                            <span>{item}</span>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                            {service.scopeNote && (
                                <div class="border-t border-slate/10 pt-4">
                                    <p class="text-sm leading-relaxed text-slate">
                                        {service.scopeNote}
                                    </p>
                                </div>
                            )}
                        </div>
                    </article>
                ))
            }
        </div>

        <div class="mt-6 grid lg:grid-cols-2 gap-6">
            {
                supportingServices.map((service) => (
                    <article
                        class:list={[
                            "relative p-7 md:p-8 rounded-2xl border transition-all",
                            service.featured
                                ? "border-accent/40 bg-ghost shadow-xl shadow-accent/10"
                                : "border-slate/10 bg-white hover:border-accent/25",
                        ]}
                    >
                        <div class="pr-20">
                            <div class="w-12 h-12 bg-accent/10 rounded-xl flex items-center justify-center mb-6 text-accent">
                                <svg
                                    class="w-6 h-6"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                    aria-hidden="true"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d={service.icon}
                                    />
                                </svg>
                            </div>
                            <h3 class="text-2xl font-bold text-navy mb-2">
                                {service.title}
                            </h3>
                        </div>
                        <p class="text-sm font-bold text-navy leading-snug mb-3">
                            {service.outcome}
                        </p>
                        <p class="text-base font-bold text-accent mb-4">
                            {service.price}
                        </p>
                        <p class="text-slate leading-relaxed mb-5">
                            {service.summary}
                        </p>
                        <div class="border-t border-slate/10 pt-5 mb-6">
                            <p class="text-xs font-bold text-navy uppercase tracking-widest mb-2">
                                {t.bestFor}
                            </p>
                            <p class="text-navy leading-relaxed">
                                {service.bestFor}
                            </p>
                        </div>
                        <p class="text-xs font-bold text-navy uppercase tracking-widest mb-3">
                            {t.includes}
                        </p>
                        <ul class="space-y-3">
                            {service.includes.map((item) => (
                                <li class="flex gap-3 text-slate leading-relaxed">
                                    <span class="mt-1 h-5 w-5 shrink-0 rounded-full bg-emerald/10 text-emerald flex items-center justify-center text-xs font-bold">
                                        ✓
                                    </span>
                                    <span>{item}</span>
                                </li>
                            ))}
                        </ul>
                    </article>
                ))
            }
        </div>

        <div class="mt-8 rounded-2xl border border-slate/10 bg-ghost p-6 md:p-7">
            <p class="text-accent text-xs font-bold uppercase tracking-widest mb-3">
                {t.addOnEyebrow}
            </p>
            <h3 class="text-2xl font-bold text-navy mb-3">
                {t.addOnTitle}
            </h3>
            <p class="text-slate leading-relaxed max-w-4xl">
                {t.addOnBody}
            </p>
        </div>

        <div class="mt-10">
            <a
                href="#contact"
                class="inline-flex w-full sm:w-auto justify-center bg-navy text-white px-8 py-4 rounded-full font-bold text-lg hover:bg-navy/90 transition-all shadow-lg shadow-navy/10"
            >
                {t.cta}
            </a>
        </div>
    </div>
</section>
