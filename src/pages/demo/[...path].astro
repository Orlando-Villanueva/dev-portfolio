---
import { getCollection } from 'astro:content';
import ExampleDemo from '@/components/ExampleDemo.astro';
import SnowDemo from '@/components/SnowDemo.astro';
import { snowDemos } from '@/data/snowDemos';

export async function getStaticPaths() {
    const demos = await getCollection('demos');
    const examples = demos.flatMap((demo) => {
        const basePath = demo.data.locale === 'fr' ? demo.data.slug : `${demo.data.locale}/${demo.data.slug}`;
        return [
            { params: { path: basePath }, props: { demo, confirmation: false } },
            { params: { path: `${basePath}/merci` }, props: { demo, confirmation: true } },
        ];
    });
    const snow = snowDemos.flatMap((prospect) => [
        { params: { path: prospect.slug }, props: { prospect, confirmation: false } },
        { params: { path: `${prospect.slug}/merci` }, props: { prospect, confirmation: true } },
    ]);
    return [...examples, ...snow];
}

const { demo, prospect, confirmation } = Astro.props;
---
{prospect ? <SnowDemo prospect={prospect} confirmation={confirmation} /> : <ExampleDemo demo={demo} confirmation={confirmation} />}
