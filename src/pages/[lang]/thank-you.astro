---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";
import { getLocalizedHomePath } from "@/i18n/routes";

export function getStaticPaths() {
    return [{ params: { lang: "en" } }, { params: { lang: "fr" } }];
}

const content = {
    en: {
        title: "Request Sent | Orlando Villanueva",
        heading: "Your request is on its way.",
        message:
            "Thanks for sharing the details. I’ll review them and reply within two business days.",
        cta: "Back to the offer",
        description:
            "Your managed website request has been sent successfully.",
    },
    fr: {
        title: "Demande Envoyée | Orlando Villanueva",
        heading: "Votre demande est en route.",
        message:
            "Merci pour les renseignements. Je les examinerai et vous répondrai dans les deux jours ouvrables.",
        cta: "Retour à l’offre",
        description:
            "Votre demande pour un site Web géré a bien été envoyée.",
    },
} as const;

const { lang } = Astro.params as { lang: keyof typeof content };
const t = content[lang];
const homePath = getLocalizedHomePath(lang);
---

<BaseLayout title={t.title} lang={lang} description={t.description}>
    <Navbar lang={lang} />
    <main class="min-h-[70vh] flex items-center justify-center py-20">
        <div class="text-center px-4">
            <div
                class="w-24 h-24 bg-green-100 text-green-600 rounded-full flex items-center justify-center mx-auto mb-8"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-12 w-12"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="3"
                        d="M5 13l4 4L19 7"></path>
                </svg>
            </div>
            <h1 class="text-4xl md:text-5xl font-bold text-navy mb-4">
                {t.heading}
            </h1>
            <p class="text-slate text-lg mb-8 max-w-md mx-auto">{t.message}</p>
            <a
                href={homePath}
                class="button-primary inline-block"
            >
                {t.cta}
            </a>
        </div>
    </main>
    <Footer lang={lang} />
    <script is:inline>
        window.addEventListener("load", () => {
            if (window.umami) window.umami.track("managed-website-form-complete");
        });
    </script>
</BaseLayout>
